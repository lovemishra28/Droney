# ==========================================
# APP & RUNTIME
# ==========================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_MEDIA_MODE="local"
NEXT_PUBLIC_WHATSAPP_BUSINESS_URL="https://wa.me/919999999999"

# ==========================================
# DATABASE (Supabase PostgreSQL via Supavisor)
# ==========================================
# Use port 6543 for transaction pooling in serverless environments
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection for migrations (port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
SUPABASE_HOST_PATTERN="https://*.supabase.co"

# ==========================================
# REDIS (Upstash Serverless)
# ==========================================
UPSTASH_REDIS_REST_URL="https://[YOUR_INSTANCE].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[YOUR_UPSTASH_TOKEN]"

# ==========================================
# OBJECT STORAGE: IMAGES (Cloudflare R2)
# ==========================================
R2_ACCOUNT_ID="[CLOUDFLARE_ACCOUNT_ID]"
R2_ACCESS_KEY_ID="[R2_ACCESS_KEY_ID]"
R2_SECRET_ACCESS_KEY="[R2_SECRET_ACCESS_KEY]"
R2_BUCKET_NAME="drone-store-media"
R2_S3_ENDPOINT="https://[CLOUDFLARE_ACCOUNT_ID].r2.cloudflarestorage.com"
R2_STORAGE_HOST_PATTERN="https://*.r2.cloudflarestorage.com"
NEXT_PUBLIC_R2_PUBLIC_DOMAIN="https://cdn.yourdronestore.in"

# ==========================================
# VIDEO STREAMING (Bunny.net Stream)
# ==========================================
BUNNY_STREAM_API_KEY="[BUNNY_STREAM_ACCESS_KEY]"
BUNNY_STREAM_LIBRARY_ID="[BUNNY_LIBRARY_ID]"
BUNNY_WEBHOOK_SECRET="[BUNNY_WEBHOOK_SIGNATURE_KEY]"
BUNNY_API_BASE_URL="https://video.bunnycdn.com"
BUNNY_TUS_ENDPOINT_URL="https://video.bunnycdn.com/tusupload"
BUNNY_API_ORIGIN="https://video.bunnycdn.com"
BUNNY_STORAGE_HOST_PATTERN="https://*.b-cdn.net"
NEXT_PUBLIC_BUNNY_STREAM_CDN_HOST="https://video.yourdronestore.in"

# ==========================================
# NOTIFICATIONS (Fast2SMS & Resend)
# ==========================================
FAST2SMS_API_KEY="[FAST2SMS_DLT_AUTHORIZATION_KEY]"
FAST2SMS_SENDER_ID="DRNSTR"
FAST2SMS_DLT_TEMPLATE_ID="[TRAI_APPROVED_TEMPLATE_ID]"
FAST2SMS_API_URL="https://www.fast2sms.com/dev/bulkV2"
RESEND_API_KEY="re_[RESEND_API_KEY]"
EMAIL_FROM_ADDRESS="orders@yourdronestore.in"

# ==========================================
# DIRECT UPI QR & MERCHANT DETAILS
# ==========================================
NEXT_PUBLIC_CLIENT_UPI_ID="merchant@upi"
NEXT_PUBLIC_CLIENT_PAYEE_NAME="AeroStore Drones India"

# ==========================================
# AUTHENTICATION & SECURITY SECRETS
# ==========================================
# Generate with: openssl rand -base64 32
SESSION_SECRET="[MINIMUM_32_CHARACTERS_RANDOM_SECRET]"
OTP_SECRET_SALT="[MINIMUM_16_CHARACTERS_SALT]"
