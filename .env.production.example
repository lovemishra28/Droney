# ==============================================================================
# AeroStore India - Production Environment Variables (.env.production)
# ==============================================================================

# Core Runtime
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://yourdronestore.in"
NEXT_PUBLIC_MEDIA_MODE="remote"
NEXT_PUBLIC_WHATSAPP_BUSINESS_URL="https://wa.me/919999999999"

# Supabase PostgreSQL (Supavisor Transaction Pooler - Port 6543)
DATABASE_URL="postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require"
# Direct connection for migrations and DDL operations (Port 5432)
DIRECT_URL="postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require"
SUPABASE_HOST_PATTERN="https://*.supabase.co"

# Edge Token & Session Secret (32-Character Cryptographic String)
SESSION_SECRET="[GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS]"
OTP_SECRET_SALT="[GENERATE_A_RANDOM_SALT_AT_LEAST_16_CHARACTERS]"

# Upstash Serverless Redis (Rate Limiting & Micro-Caching)
UPSTASH_REDIS_REST_URL="https://ap-south-1-your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="[YOUR_UPSTASH_REST_TOKEN]"

# Cloudflare R2 Storage (Image Delivery)
R2_ACCOUNT_ID="c4820a18e..."
R2_ACCESS_KEY_ID="[YOUR_R2_ACCESS_KEY_ID]"
R2_SECRET_ACCESS_KEY="[YOUR_R2_SECRET_ACCESS_KEY]"
R2_BUCKET_NAME="aerostore-hardware-production"
R2_S3_ENDPOINT="https://[CLOUDFLARE_ACCOUNT_ID].r2.cloudflarestorage.com"
R2_STORAGE_HOST_PATTERN="https://*.r2.cloudflarestorage.com"
NEXT_PUBLIC_R2_PUBLIC_DOMAIN="https://cdn.yourdronestore.in"

# Bunny.net Stream (HLS Video Processing)
BUNNY_STREAM_LIBRARY_ID="289104"
BUNNY_STREAM_API_KEY="[YOUR_BUNNY_STREAM_API_KEY]"
BUNNY_WEBHOOK_SECRET="[YOUR_BUNNY_WEBHOOK_SECRET]"
BUNNY_API_BASE_URL="https://video.bunnycdn.com"
BUNNY_TUS_ENDPOINT_URL="https://video.bunnycdn.com/tusupload"
BUNNY_API_ORIGIN="https://video.bunnycdn.com"
BUNNY_STORAGE_HOST_PATTERN="https://*.b-cdn.net"
NEXT_PUBLIC_BUNNY_STREAM_CDN_HOST="https://video.yourdronestore.in"

# Communications (Indian DLT SMS & Transactional Email)
FAST2SMS_API_KEY="[YOUR_FAST2SMS_API_KEY]"
FAST2SMS_SENDER_ID="AEROIN"
FAST2SMS_DLT_SENDER_ID="AEROIN"
FAST2SMS_DLT_TEMPLATE_ID="1107168920194827192"
FAST2SMS_API_URL="https://www.fast2sms.com/dev/bulkV2"
RESEND_API_KEY="re_[YOUR_RESEND_API_KEY]"
EMAIL_FROM_ADDRESS="AeroStore Dispatch <orders@yourdronestore.in>"

# Direct UPI Settlement Particulars
NEXT_PUBLIC_CLIENT_UPI_ID="aerostore@icici"
NEXT_PUBLIC_CLIENT_PAYEE_NAME="AeroStore Drones Private Limited"

# Scheduled Maintenance Secret
CRON_SECRET="[YOUR_CRON_SECRET]"
